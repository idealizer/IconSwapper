<Window x:Class="IconSwapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IconSwapper"
        Width="1080"
        Height="840"
        MinWidth="920"
        MinHeight="640"
        Background="#EFEAE2"
        FontFamily="Segoe UI"
        FontSize="14"
        Foreground="#1F1A17"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#1F6B4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#18573C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFCF7"/>
            <Setter Property="Foreground" Value="#1F1A17"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderBrush" Value="#D5CEC3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3EFE7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#D5CEC3"/>
            <Setter Property="Background" Value="#FFFCF7"/>
            <Setter Property="Foreground" Value="#1F1A17"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F3EFE7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#E4F0E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="IconSwapper" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Set the icon for a file type, and for your own shortcuts to the app that opens it."
                           Foreground="#6E675F" Margin="0,2,0,14"/>
                <Grid>
                    <TextBox x:Name="SearchBox" FontSize="15" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                    <TextBlock x:Name="SearchHint" Text="Search .docx or WordCraft" Foreground="#8A837A"
                               Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Documents" Tag="Documents" Click="Preset_Click" Style="{StaticResource Chip}"/>
                    <Button Content="Spreadsheets" Tag="Spreadsheets" Click="Preset_Click" Style="{StaticResource Chip}"/>
                    <Button Content="Presentations" Tag="Presentations" Click="Preset_Click" Style="{StaticResource Chip}"/>
                    <Button Content="PDF" Tag="PDF" Click="Preset_Click" Style="{StaticResource Chip}"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="Restart Explorer" Click="Restart_Click" Style="{StaticResource QuietButton}"
                    VerticalAlignment="Top" Margin="16,36,0,0" ToolTip="Use this if Explorer keeps showing the old icon."/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#FFFCF7" CornerRadius="12" Padding="14" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="340"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Results" FontWeight="SemiBold" Margin="4,0,0,8"/>
                        <TextBlock x:Name="EmptyResults" Text="Matches show up here." Foreground="#8A837A" Margin="4,8,0,0"/>
                        <ListBox x:Name="ResultsList" SelectionChanged="ResultsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="28" Height="28" Source="{Binding Icon}" Margin="0,0,10,0"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#6E675F" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,14,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Icons you've set" FontWeight="SemiBold" Margin="4,0,0,8"/>
                        <TextBlock x:Name="EmptyLibrary" Text="Nothing customized yet." Foreground="#8A837A" Margin="4,8,0,0"/>
                        <ListBox x:Name="LibraryList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="24" Height="24" Source="{Binding Icon}" Margin="0,0,8,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="#6E675F" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Restore" Click="LibraryRestore_Click"
                                                Style="{StaticResource QuietButton}" Padding="10,4" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#FFFCF7" CornerRadius="12" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="HeaderTitle" Text="Choose a file type" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HeaderDetail" Text="Search for an extension or an app, or pick a group above."
                                   Foreground="#6E675F" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Width="88" Margin="0,0,16,0">
                                <Border Width="72" Height="72" Background="#F7F4EE" CornerRadius="8" BorderBrush="#E2DBD1" BorderThickness="1">
                                    <Image x:Name="CurrentIcon" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock x:Name="CurrentCaption" Text="Current" Foreground="#6E675F" FontSize="12"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Grid x:Name="DropZone" Height="96" AllowDrop="True"
                                      PreviewDragOver="DropZone_DragOver" PreviewDrop="DropZone_Drop">
                                    <Rectangle RadiusX="8" RadiusY="8" Fill="#F7F4EE" Stroke="#C9C0B4" StrokeThickness="1.5" StrokeDashArray="3 2"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="DropLabel" Text="Drop a PNG, JPG, or ICO here" HorizontalAlignment="Center"/>
                                        <Button Content="Browse…" Click="Browse_Click" Style="{StaticResource QuietButton}"
                                                HorizontalAlignment="Center" Margin="0,8,0,0" Padding="12,4"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                                    <StackPanel Margin="0,0,14,0">
                                        <Image x:Name="Preview16" Width="16" Height="16" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        <TextBlock Text="16" FontSize="11" Foreground="#8A837A" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <Image x:Name="Preview32" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        <TextBlock Text="32" FontSize="11" Foreground="#8A837A" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <Image x:Name="Preview48" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="48" FontSize="11" Foreground="#8A837A" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <Image x:Name="Preview256" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="256" FontSize="11" Foreground="#8A837A" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,18,0,6">
                            <TextBlock DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Bottom">
                                <Hyperlink NavigateUri="https://icons8.com" RequestNavigate="Icons8Link_RequestNavigate">Icons by Icons8</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="Or pick one from Icons8" FontWeight="SemiBold"/>
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Search" Click="Icons8Search_Click"
                                    Style="{StaticResource QuietButton}" Margin="8,0,0,0"/>
                            <ComboBox x:Name="Icons8Style" DockPanel.Dock="Right" Width="130" Margin="8,0,0,0"
                                      DisplayMemberPath="Label" VerticalContentAlignment="Center"
                                      SelectionChanged="Icons8Style_SelectionChanged"/>
                            <TextBox x:Name="Icons8Box" KeyDown="Icons8Box_KeyDown" ToolTip="Search Icons8, such as docx or spreadsheet"/>
                        </DockPanel>
                        <ListBox x:Name="Icons8List" Height="196" Margin="0,8,0,0" SelectionChanged="Icons8List_SelectionChanged"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Margin" Value="0,0,4,4"/>
                                    <Setter Property="Padding" Value="6"/>
                                    <Setter Property="ToolTip" Value="{Binding Tip}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Image Width="44" Height="44" Source="{Binding Thumbnail}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <DockPanel Margin="0,6,0,0">
                            <Button x:Name="Icons8More" DockPanel.Dock="Right" Content="More" Click="Icons8More_Click"
                                    Style="{StaticResource QuietButton}" Padding="10,4" IsEnabled="False"/>
                            <TextBlock x:Name="Icons8Status" Text="Choose a file type to see matching icons."
                                       Foreground="#8A837A" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>

                        <TextBlock Text="File types" FontWeight="SemiBold" Margin="0,18,0,6"/>
                        <ItemsControl x:Name="ChoiceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Extension}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Note}" Foreground="#6E675F" FontSize="12" Margin="10,2,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Add" Click="AddExtension_Click" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/>
                            <TextBox x:Name="AddBox" ToolTip="Add another extension, such as .md" KeyDown="AddBox_KeyDown"/>
                        </DockPanel>
                        <TextBlock x:Name="WarningText" Foreground="#8A5A12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <CheckBox x:Name="ShortcutCheck" Margin="0,14,0,0" Checked="ShortcutCheck_Changed" Unchecked="ShortcutCheck_Changed"
                                  Content="Also update Start menu, desktop, and taskbar shortcuts"/>
                        <TextBlock Text="A running window keeps the icon built into the program."
                                   Foreground="#8A837A" FontSize="12" Margin="22,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="ApplyButton" Content="Use this icon" Click="Apply_Click" Style="{StaticResource AccentButton}" IsEnabled="False"/>
                            <Button x:Name="RestoreButton" Content="Restore selected" Click="RestoreSelected_Click"
                                    Style="{StaticResource QuietButton}" Margin="10,0,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBox x:Name="StatusText" Grid.Row="2" Margin="2,12,2,0" IsReadOnly="True" BorderThickness="0"
                 Background="Transparent" TextWrapping="Wrap" IsTabStop="False" Foreground="#3E3832"/>
    </Grid>
</Window>
